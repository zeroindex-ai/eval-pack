{
  "name": "@zeroindex-ai/eval-pack",
  "version": "0.2.0",
  "description": "Opinionated open-source eval harness for RAG and agent apps built on Claude",
  "type": "module",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "bin": {
    "eval-pack": "dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./checks": {
      "types": "./dist/core/checks.d.ts",
      "import": "./dist/core/checks.js",
      "default": "./dist/core/checks.js"
    },
    "./judge-claude": {
      "types": "./dist/judge-claude/index.d.ts",
      "import": "./dist/judge-claude/index.js",
      "default": "./dist/judge-claude/index.js"
    },
    "./report-html": {
      "types": "./dist/report-html/index.d.ts",
      "import": "./dist/report-html/index.js",
      "default": "./dist/report-html/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.95.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeroindex-ai/eval-pack.git"
  },
  "homepage": "https://github.com/zeroindex-ai/eval-pack#readme",
  "bugs": {
    "url": "https://github.com/zeroindex-ai/eval-pack/issues"
  },
  "license": "MIT",
  "keywords": [
    "evals",
    "llm-as-judge",
    "rag",
    "agent",
    "claude",
    "anthropic",
    "testing",
    "ai"
  ],
  "packageManager": "pnpm@10.0.0"
}
